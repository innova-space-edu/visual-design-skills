# Optional generative providers
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=low

BFL_API_KEY=
BFL_IMAGE_MODEL=flux-2-pro

# Recommended for any public deployment that has paid provider keys.
DEMO_ACCESS_TOKEN=

# Dangerous for paid keys on public URLs. Leave false unless intentional.
ALLOW_PUBLIC_GENERATION=false
