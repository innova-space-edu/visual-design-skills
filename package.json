{
  "name": "@innova-space/visual-design",
  "version": "1.5.0",
  "description": "Local-first visual design routing, planning, provider execution and modular AI design skills.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./packages/sdk/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./packages/sdk/index.js"
    },
    "./core": "./packages/core/index.js",
    "./browser": "./packages/browser/index.js",
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./packages/server/index.js"
    },
    "./providers": {
      "types": "./types/providers.d.ts",
      "default": "./packages/providers/index.js"
    },
    "./nextjs": "./adapters/nextjs/index.js",
    "./cloudflare": "./adapters/cloudflare/index.js",
    "./registry": "./registry.json"
  },
  "files": [
    "packages",
    "adapters",
    "types",
    "skills",
    "schemas",
    "routing",
    "references",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "validate": "npm run lint:skills && npm run validate:examples && npm run validate:evals",
    "lint:skills": "node scripts/lint-skills.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "validate:evals": "node scripts/validate-evals.mjs",
    "route": "node scripts/route.mjs",
    "list": "node scripts/list-skills.mjs",
    "validate:brief": "node runtime/validate-brief.mjs",
    "select:backend": "node runtime/select-backend.mjs",
    "compile": "node runtime/compile.mjs",
    "test:web-sdk": "node scripts/test-web-sdk.mjs",
    "test:providers": "node scripts/test-providers.mjs",
    "check:browser": "node scripts/check-browser-safe.mjs",
    "benchmark:router": "node scripts/benchmark-router.mjs",
    "pack:check": "npm pack --dry-run",
    "build:skill-guidance": "node scripts/build-skill-guidance.mjs",
    "prepare": "npm run build:skill-guidance",
    "test:skill-guidance": "node scripts/test-skill-guidance.mjs"
  },
  "keywords": [
    "ai",
    "image-generation",
    "design",
    "agent-skills",
    "visual",
    "svg",
    "maps",
    "infographics"
  ]
}
