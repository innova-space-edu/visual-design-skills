{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RenderPlan",
  "type": "object",
  "required": [
    "strategy",
    "steps"
  ],
  "properties": {
    "strategy": {
      "enum": [
        "deterministic",
        "hybrid",
        "generative"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "backend": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}