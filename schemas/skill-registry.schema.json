{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillRegistry",
  "type": "object",
  "required": [
    "version",
    "suite",
    "skills"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "suite": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "category",
          "default_render_strategy"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "default_render_strategy": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}