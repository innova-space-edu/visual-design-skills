{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoutingResult",
  "type": "object",
  "required": [
    "primary_intent",
    "visual_type",
    "selected_skills",
    "render_strategy",
    "validation_profile"
  ],
  "properties": {
    "primary_intent": {
      "type": "string"
    },
    "visual_type": {
      "type": "string"
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "subdomain": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "render_strategy": {
      "enum": [
        "deterministic",
        "hybrid",
        "generative"
      ]
    },
    "preferred_backends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_backends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_profile": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}